@model List<Category>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category Listing Page</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .category-card img {
        height: 200px;
        object-fit: cover;
        }

        .category-card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s;
        }

        .category-card:hover {
        transform: scale(1.05);
        }
    </style>
</head>
<body>
    <div class="container py-5">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="fw-bold">Kategori Listeleme</h1>
            <input type="text" class="form-control w-25" placeholder="Search categories...">
        </div>
        
     @{
            @if (TempData["Messages"] is List<(string Key, string Message)> messages)
            {
                foreach (var (key, message) in messages)
                {
                    <div class="alert alert-@key alert-dismissible fade show" role="alert">
                        <strong>
                            @(key == "success" ? message.ToString() : key == "danger" ? "Hata!" : "Mesaj:")
                        </strong>
                        @message
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            }

               
         

        }
            
                
                    
            


        <!-- Grid Layout -->
        <div class="row g-4">
            @foreach (var item in Model)
            {
                
            
            <!-- Category Card -->
            <div class="col-md-4 col-sm-6">
                <div class="card category-card">
                        <img src="~/Resimler/KategoriResimler/@item.CategoryImage" class="card-img-top" alt="Category Image">
                    <div class="card-body">
                        <h5 class="card-title">@item.CategoryName</h5>
                        <p class="card-text">This is a short description of category 1.</p>
                            <a href="/Admin/EditCategory/@item.CategoryId" class="btn btn-primary">Kategori Düzenleme</a>
                            <a href="/Admin/DeleteCategory/@item.CategoryId" class="btn btn-danger">Kategoriyi Sil</a>
                    </div>
                </div>
            </div>
            }
         </div>
    </div>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@model Author
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yazar Ekle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #6a11cb, #2575fc);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            color: whitee;
        }

        .form-container {
            background-color: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }

            .form-container h1 {
                font-family: 'Georgia', serif;
                font-weight: bold;
                text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
            }

        .btn-custom {
            background-color: #ff7eb3;
            border: none;
            transition: all 0.3s ease;
        }

            .btn-custom:hover {
                background-color: #ff4a93;
                transform: scale(1.05);
            }
    </style>
</head>
<body>
    <div class="form-container">
        <h1 class="text-center mb-4">Yazar Ekle</h1>
        <form action="AddAuthor" method="post">
            <div class="mb-3">
                 
                <input type="hidden" class="form-control" id="authorId" asp-for="Id"  >
            </div>
            <div class="mb-3">
                <label for="authorName" class="form-label">Yazar Adı</label>
                <input type="text" class="form-control" id="authorName" name="AuthorName" placeholder="Örn: Mehmet Yılmaz" required>
            </div>
            <div class="text-center">
                <button type="submit" class="btn btn-custom btn-lg">Ekle</button>
            </div>
        </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

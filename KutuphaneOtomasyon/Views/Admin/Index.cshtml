
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var    deger = @ViewBag.mostborrowedbook;
}

@{
    if (ViewBag.Index !=null && (bool)ViewBag.Index) 
    {
        var KayıtDurumu = ViewBag.KayıtDurumu;
        if (KayıtDurumu > 0)
        {
            <div style="background-color:green; color:black;height30px;width:30px">
                @KayıtDurumu;
            </div>
        }
        else
        {
            <div style="background-color:red; color:black;height30px;width:30px">
                @KayıtDurumu.M;
            </div>
        }
    }



    <h2>📊 Admin Dashboard</h2>

    <div class="dashboard-container">
        <div class="stat-card">
            <h3>📚 Toplam Kitap Sayısı</h3>
            @ViewBag.totalbook

        </div>

        <div class="stat-card">
            <h3>👥 Toplam Kullanıcı Sayısı</h3>
            @ViewBag.totaluser
        </div>

        <div class="stat-card">
            <h3>💰 Kütüphane Geliri</h3>
            @ViewBag.totalbalance

        </div>

        <div class="stat-card">
            <h3>📖 Toplam Ödünç Alınan Kitap</h3>
            @ViewBag.totalborrow

        </div>

        <div class="stat-card">
            <h3>📕 Aktif Ödünç Kitaplarr</h3>
            @ViewBag.nottotalborrow
        </div>

        <div class="stat-card">
            <h3>🔥 En Çok Okunan Kitaplar</h3>
            <ul>
                @{
                 
                }
                @foreach (var item in deger)
                {
                   @item.ToString();
                }
            </ul>
        </div>
    </div>

    <style>
        .dashboard-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .stat-card {
            background-color: #f4f4f4;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 2px 2px 10px rgba(0,0,0,0.1);
            flex: 1 1 calc(33.333% - 20px);
            text-align: center;
        }

            .stat-card h3 {
                margin-bottom: 10px;
            }
    </style>

}
 


@model Book;
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>EditBook</title>
</head>
<body>
    <form  asp-action="EditBook" asp-controller="Admin" method="post" enctype="multipart/form-data">
        <input type="hidden"asp-for="BookId"/>

        <div class="form-row">
            <div class="col">
                <label>Book Name</label>
                <input type="text" asp-for="BookName" class="form-control"  >
            </div>
            <div class="col">
                <label>Author</label>
                <input type="text" asp-for="Author.AuthorName" class="form-control" placeholder="Last name">
            </div>
            <div class="col">
                <label>Author</label>
                <input type="text" asp-for="AssetNumber" class="form-control" placeholder="Last name">
            </div
             <div class="col">
                <label>Author</label>
                <input type="text" asp-for="ISBN" class="form-control" placeholder="Last namee">
            </div>

            </div
             <div class="col">
                <label>Publisher</label>
                <input type="text" asp-for="Publisher" class="form-control" placeholder="Last name">
            </div>
            </div
             <div class="col">
                <label>Publisher Year</label>
                <input type="date" asp-for="PublicationYear" class="form-control" placeholder="Last name" value="PublicationYear">
            </div>
            <div>
                @Html.DropDownListFor(x=>x.CategoryId,ViewBag.cat as IEnumerable<SelectListItem>,"Kategori Şeçiniz")
            </div>

            <div>
                <input type="file" asp-for="BookImage" />
            </div>
            <input type="submit"  class="btn btn-outline-info" value="Submit" />
        </div>
    </form>
</body>
</html>

@model List<User>

@{
    ViewData["Title"] = "Members";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

}
 

<head>
@* <link href="/css/AdminController/Members.css" rel="stylesheet" />
 *@
    <link href="/css/Member/Member.css" rel="stylesheet" />

</head>
 <body>

 <table class="table table-striped " >
    <thead>
        <th>Id</th>
        <th>Full Name</th>
        <th>User Name</th>
        <th>Şifre</th>
        <th>E-Mail</th>
        <th>Phone</th>
        <th>Address</th>
        <th>UserImg</th>
        <th>Eylemler</th>
       
    </th>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@{@item.Name} @{@item.Surname}</td>
            <td>@item.Username</td>
            <td>@item.Password</td> 
            <td>@item.Email</td>
                <td>@item.Phone</td>
            <td>@item.Address</td>
            <td >
                <div class="cerceve" typeof="image" >
                    <img src="/User/@item.UserImg" alt="Kullanıcı Resmi" />
                </div>
             </td>
             s
            <td>
                 <a class="btn btn-info" href="/Admin/EditMembers/@item.Id">Düzenle</a>
                 <a class="btn btn-danger" href="/Admin/DeleteMember/@item.Id">Kullanıcıyı Sil</a>
            </td>

        </tr>
        
    }

</table> 

 
</body>
 @model List<Author>

@{
    ViewData["Title"] = "AuthorList";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<table class="table table-bordered">

    <tr>
        <th>Yazar Adı</th>
        <th>Kitaplar</th>
        <th>Sil</th>
        <th>Güncelle</th>
    </tr>
    @foreach (var yazar in Model)
    {
        l
        <tr>
            <td>@yazar.AuthorName</td>
            <td>@foreach (var item in yazar.Books)
                {
                    @($"{item.BookName},")
                }
            </td>
            <td>@Html.ActionLink("Sil", "DeleteAuthor", new { id = yazar.Id }, new { @class = "btn btn-danger", onclick = "return confirm('Silmek istiyor musunuz?')" })</td>
            <td><a href="/Admin/EditAuthor/@yazar.Id" class="btn btn-success">Güncelle</a></td>
        </tr>
    }
 </table>


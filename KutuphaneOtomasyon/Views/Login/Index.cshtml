@model User

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <title>Daily UI | #001 - Sign Up</title>
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <link href="/css/LoginController/login.css" rel="stylesheet" />


</head>
<body class="align">

    @if (ViewBag.SuccesLogin!= null)
    {
        <div id="succeslogin" class="alert alert-success mt-1" role="alert">
            @ViewBag.SuccesLogin
        </div>


    }
    @if (ViewBag.ErrorLogin != null)
    {
        <div id="loginErrorAlert" class="alert alert-danger mt-1" role="alert">
            @ViewBag.ErrorLogin
        </div>


    }  

    <script>
        setTimeout(function () {
            var alert = document.getElementById("succeslogin");
            if (alert) {
                alert.style.transition = "opacity 0.5s ease-out";
                alert.style.opacity = "0";

                // Tamamen gizlemek için DOM'dan da kaldırmak istersen:
                setTimeout(function () {
                    alert.remove();
                }, 500);
            }
        }, 3000); // 3000 milisaniye = 3 saniye


        setTimeout(function () {
            var alert = document.getElementById("loginErrorAlert");
            if (alert) {
                alert.style.transition = "opacity 0.5s ease-out";
                alert.style.opacity = "0";

                // Tamamen gizlemek için DOM'dan da kaldırmak istersen:
                setTimeout(function () {
                    alert.remove();
                }, 500);
            }
        }, 3000); // 3000 milisaniye = 3 saniye
    </script>

    <div class="grid align__item d-flex justify-content-center" style="position:relative;min-height:100%;">
        <div class="position-absolute bg-primary rounded-3 w-50 h-75" style="top: 130px; left: 335px; z-index: 0; border:2px solid black;"></div>

        <div class="register bg-light w-50 h-50 text-center mt-5 m-auto rounded-3 mb-5" style="position: relative; z-index: 1; border:2px solid black;">

           

            <h2 class="mb-2">Giriş Yap</h2>
            <p class="text-muted">Kimlik bilgilerinizi girin.</p>

            <form action="" method="post" class="form mt-5">

                <input type="hidden" asp-for="Id" value="" />
                <input type="hidden" asp-for="Role" value="" />

                <div class="form__field mt-2">
                    <input type="email" asp-for="Email" placeholder="info@mailaddress.com">
                     
                    <br />
                    <span asp-validation-for="Email" class="text-danger my-2"></span>
                </div>


                <div class="form__field mt-2">
                    <input type="password" asp-for="Password" placeholder="••••••••••••">
                    <br />
                    <span asp-validation-for="Password" class="text-danger my-2"></span>
                </div>
                <div class="g-recaptcha mt-3 d-inline-block" data-sitekey="6LcIgBsrAAAAACLVKy4ta1axLXj_mTr78Q6Ykk2Q"></div>

                <div class="form__field mt-2 " style="width:auto; height:70px;">
                    <input type="submit" value="Giriş Yap" class="w-100 bg-primary text-white">
                </div>

            </form>

          <a href="/Login/ForgotPassword" class="text-decoration-none text-dark fw-bolder">Şifremi Unuttum</a>

        </div>

    </div>

</body>

<script>
    $('form').submit(function () {
                 var recaptchaResponse = $('#g-recaptcha-response').val();
                 $('input[name="RecaptchaToken"]').val(recaptchaResponse);
             })
</script>
</html>

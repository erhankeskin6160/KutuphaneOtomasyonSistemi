@model UserViewModel;
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kullanıcı Kayıt Formu</title>
    <link href="/css/LoginController/login.css" rel="stylesheet" />

    <style>
        
/* 
        .edit-form {
            background-color: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
            width: 400px;
        }

            .edit-form h2 {
                text-align: center;
                margin-bottom: 20px;
                color: #343a40;
            }

        .btn-custom {
            background-color: #007bff;
            color: white;
            border-radius: 50px;
            width: 100%;
        }

            .btn-custom:hover {
                transition: 4s;
                background-color: yellow;
            } */
    </style>

</head>
<body>

    @if (ViewBag.SuccesLogin != null)
{
    <div class="alert alert-success" id="registerSuccess">
        @ViewBag.SuccesLogin
    </div>

    <script>
        setTimeout(function () {
            window.location.href = '@Url.Action("Index", "Home")';
        }, 5000);  
    </script>
}
    <div class="edit-form">

        <div class="container" style="position:relative">
            <div class="position-absolute bg-primary rounded-3" style="top: 25px; left: 345px; z-index: 1; border:2px solid black; width:630px;height:732px"></div>
            <div class="w-50 h-50 text-center  bg-light mt-5 mb-5 rounded-3 m-auto p-5" style="border:2px solid black; position:relative;min-height:100%; z-index:2;">
                

                <h2>Kullanıcı Kayıt Formu</h2>

        <form asp-controller="Login" asp-action="Register" method="post" enctype="multipart/form-data">

            <div class="mb-3">
                <input type="text" asp-for="Name" class="form-control" placeholder="İsim">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="text" asp-for="Surname" class="form-control" placeholder="Soyisim">
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="password" asp-for="Password" class="form-control" placeholder="Şifre">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Şifreyi Tekrar Gir">
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="email" placeholder="E-Mail Adresinizi Girin" asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="tel" asp-for="Phone" class="form-control" id="phone" placeholder="Telefon Numarası">
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="text" asp-for="Address" class="form-control" placeholder="Adres Girin">
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="pe-2 fw-bolder    ">Fotoğraf Yükle</label>
                <input type="file" asp-for="UserImg" />
                <span asp-validation-for="UserImg" class="text-danger"></span>

                        
            </div>

            <div class="g-recaptcha" data-sitekey="6LcIgBsrAAAAACLVKy4ta1axLXj_mTr78Q6Ykk2Q"></div>

             <input type="hidden" asp-for="RecaptchaToken" /> 

            <button type="submit" class="btn btn-primary mt-2 w-100">Kaydet</button>
 
        </form> 

        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

   <script>
            $('form').submit(function () {
                         var recaptchaResponse = $('#g-recaptcha-response').val();
                         $('input[name="RecaptchaToken"]').val(recaptchaResponse);
                     })
                      </script>

    </div>
    </div> 
    </div>

</body>
</html>
 
@{
    ViewData["Title"] = "Şifrenizi Unuttunuz";
}



@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}
<head>
    <link href="/css/LoginController/login.css" rel="stylesheet" />
</head>
<body>
@using (Html.BeginForm("ForgotPassword", "Login", FormMethod.Post))
{
    @Html.AntiForgeryToken()

        <div class="register bg-light w-50 h-50 text-center mt-5 m-auto rounded-3 mb-5" style="position: relative; z-index: 1; border:2px solid black;">
            <h2>@ViewData["Title"]</h2>
    <div class="form-group">
        <input type="email" id="Email" name="Email" class="form-control" placeholder="E-posta adresinizi girin" required />
    </div>

    <button type="submit" class="btn btn-primary mt-3 w-100">Şifre Sıfırlama Linki Gönder</button>
            <div class="form-group mt-3">
                <a class="text-decoration-none text-dark fw-bolder" href="@Url.Action("Index","Login")">Hesabınız varsa giriş yapın</a>
            </div>
        </div>
       
}


</body>

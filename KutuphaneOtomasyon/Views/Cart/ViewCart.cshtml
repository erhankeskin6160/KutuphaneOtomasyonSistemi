@model List<CartItem>
<h2 class="mt-5 text-center">Sepetiniz</h2>



@if (TempData["ErroCart"] != null)
{
    <div class="alert alert-primary" role="alert" id="erroCartAlert">
        @TempData["ErroCart"]
    </div>
    <script>
        setTimeout(function () {
            var alertBox = document.getElementById("erroCartAlert");
            if (alertBox) {
                alertBox.style.transition = "opacity 0.5s ease";
                alertBox.style.opacity = 0;
                setTimeout(function () {
                    alertBox.remove();
                }, 500); // fade out süresi
            }
        }, 5000); // 5 saniye sonra kaybolsun
    </script>
}

<table>
    <tr>
        <th>Kitap Adı</th>
        <th>Yazar</th>
        <th>Adet</th>
        <th>İşlem</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr class="bg-primary">
            <td>@item.Book.BookName</td>
            <td>@item.Book.Author.AuthorName</td>
             <td>@item.Quantity</td> 

            <td>


                <form asp-controller="Cart" asp-action="RemoveToCart" method="post" style="display:inline;">
                    <input type="hidden" name="BookId" value="@item.BookId" />
                    <button type="submit" class="btn btn-danger">Kaldır</button>
                </form>


            </td>
        </tr>
    }
</table>

<form asp-action="CheckoutCartItems" asp-controller="Cart" method="post" class="d-flex">
    <button type="submit" class="btn btn-primary w-100 ms-5 ">Ödünç Al</button>
</form>

@model List<BookLoan>


<form method="get">
    <div class="form-group mb-4 m-auto">
        <input type="hidden" name="BookId" />
        <input type="text" name="BookName" id="BookName" class="form-control w-75 mt-3 d-inline-block py-2" value="@ViewBag.SelectedBookTitle"  placeholder="Kitap Adı"/>
        <button type="submit" class="btn btn-primary d-inline-block rounded-1 btn-sm py-2">Filtrele</button>

    </div>

</form>

<!-- Kitap Listesi -->
@if (TempData["SuccesReturnDate"] != null)

{
    <div id="succes-message" class="alert alert-succes" role="alert">
        @TempData["SuccesReturnDate"]
    </div>
    <script>

        setTimeout(function () {
            var alertMessage = document.getElementById("succes-message");
            if (alertMessage) {
                alertMessage.style.display = "none";
            }
        },10000);
    </script>


}
@if (TempData["ErrorBookTotal"] != null)

{
    <div id="succes-message" class="alert alert-danger" role="alert">
        @TempData["ErrorBookTotal"]
    </div>
    <script>

        setTimeout(function () {
            var alertMessage = document.getElementById("succes-message");
            if (alertMessage) {
                alertMessage.style.display = "none";
            }
        },10000);
    </script>


}

 



<div class="row">
    @{int  sayac = 0;}
    @foreach (var bookLoan in Model)
    {

       
        <div class="col-md-3 mb-4">
            <div class="card shadow">
                <img src="@bookLoan.Book.BookImage" class="card-img-top" alt="Kitap Resmi" style="height: 27.5rem;width:auto; background-size:cover">
                <div class="card-body">
                     <h5 class="card-title text-center mb-4">@bookLoan.Book.BookName</h5>
                    <p class="fw-lighter" style="margin-left:2px;">📅 Aldığı Tarih: @bookLoan.LoanDate.ToShortDateString()</p>
                    <p class="fw-lighter">⏰ Teslim Tarihi: @bookLoan.DeliveryDate.ToShortDateString()</p>
                    <p class="fw-lighter">📚 Kategori: @bookLoan.Book.Category.CategoryName</p>
                    @if ((bookLoan.Status!=BookLoan.LoanStatus.Returned  ))
                    {
                         <a href="@Url.Action("ReturnBook", "Book", new {loanıd =bookLoan.Id })" class="btn btn-danger text-center ms-5">Kitabı Teslim Et</a>
                    }
                   
                </div>
            </div>
            

        </div>

        sayac++;

        if (sayac % 4==0)
        {
           <div class="w-100"><hr /></div>
        
        }
           

        
       
    }
</div>

<!-- Sayfalama Kontrolü -->
<div class="row">
    <div class="col-md-12 text-center">
        <nav aria-label="Sayfalama">
            <ul class="pagination">
                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)&bookTitle=@ViewBag.SelectedBookTitle" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="?page=@i&bookTitle=@ViewBag.SelectedBookTitle">@i</a>
                    </li>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)&bookTitle=@ViewBag.SelectedBookTitle" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

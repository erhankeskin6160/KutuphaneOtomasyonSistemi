 @model List<Notifications>
@{
    ViewBag.Title = "Duyurular";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/css/bootstrap.css" />


</head>


<div class="container">

<div class="row">

<div class="col-12">

    <h2 class="text-center mt-3">Duyurular</h2>

    <table class="table table-bordered">

    <tr class="bg-text-primary rounded-3">
        <th class="text-bg-dark text-center">Kategori</th>
        <th class="text-bg-dark text-center">Tarih</th>
        @* <th>İçerik</th> *@
    </tr>
    @foreach (var notifications in Model)
    {
        <tr class="bg-primary">
            <td class="text-bg-primary">@notifications.Subject</td>
           
            <td class="text-bg-primary">@notifications.Content</td>
        </tr>
    }
</table>
</div>
</div>
</div>


@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@model List<Book>

@{
    Layout = "_Layout";
}
<!DOCTYPE html>

<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kütüphane Sitesi</title> 
    <link href="/css//HomeController/index.css" rel="stylesheet" />

    <script>
        function updateCartCount() {
        fetch('/Cart/GetCartCount')
        .then(response => response.json())
        .then(count => {
        const cartCountElement = document.getElementById('cart-count');
        if (count > 0) {
        cartCountElement.textContent = count;
        cartCountElement.style.display = 'inline'; // Sayıyı göster
        } else {
        cartCountElement.style.display = 'none'; // Sayı yoksa gizle
        }
        })
        .catch(error => console.log('Hata:', error));
        }

        document.addEventListener('DOMContentLoaded', updateCartCount); // Sayfa yüklendiğinde sepet sayısını günceller.
    </script>

</head>

<body>

    @if(TempData["Message"] != null)

    {
        <div id="alert-message" class="alert alert-warning" role="alert">
            @TempData["Message"]
        </div>
        <script>

            setTimeout(function () {
            var alertMessage = document.getElementById("alert-message");
            if (alertMessage) {
            alertMessage.style.display = "none";  
            }
            },10000);  
        </script>


    }



    <!-- Navbar -->
     

    <!-- Hero Section -->
    <div class="heros mt-1 rounded-4">
        <h1>Hoş Geldiniz, Kitap Dünyasına!</h1>
        <p>Binlerce kitap keşfetmeye hazır mısınız? Aradığınız tüm kitaplar burada.</p>
        <form class="d-flex justify-content-center mt-3" asp-controller="Book" asp-action="SearchBook">
            <input class="form-control w-50" type="search" name="key" placeholder="Kitap ,ISBN veya yazar göre ara..." aria-label="Arama">
            <button class="btn btn-primary ms-2" type="submit">Ara</button>
        </form>
    </div>

    <!-- Categories Section -->
    <div class="container my-5">
        <h2 class="text-center mb-4">Popüler Kategoriler</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="card category-card p-4 text-bg-primary">
                    <h3>Edebiyat</h3>
                    <p>Roman, şiir ve daha fazlası</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card category-card p-4 text-bg-primary">
                    <h3>Bilim</h3>
                    <p>Bilimsel araştırmalar ve keşifler</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card category-card p-4 text-bg-primary">
                    <h3>Tarih</h3>
                    <p>Geçmişe dair tüm eserler</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container my-5">

        <h2 class="text-center mb-4 d-flex justify-content-center align-items-center gap-2">
            <!-- Sol hoparlör -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 512 512">
                <path d="M480 32c0-12.9-7.8-24.6-19.8-29.6s-25.7-2.2-34.9 6.9L381.7 53c-48 48-113.1 75-181 75l-8.7 0-32 0-96 0c-35.3 0-64 28.7-64 64l0 96c0 35.3 28.7 64 64 64l0 128c0 17.7 14.3 32 32 32l64 0c17.7 0 32-14.3 32-32l0-128 8.7 0c67.9 0 133 27 181 75l43.6 43.6c9.2 9.2 22.9 11.9 34.9 6.9s19.8-16.6 19.8-29.6l0-147.6c18.6-8.8 32-32.5 32-60.4s-13.4-51.6-32-60.4L480 32zm-64 76.7L416 240l0 131.3C357.2 317.8 280.5 288 200.7 288l-8.7 0 0-96 8.7 0c79.8 0 156.5-29.8 215.3-83.3z" />
            </svg>

            <!-- Başlık metni -->
            <span>Kütüphane Duyuru</span>

            <!-- Sağ hoparlör -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 512 512" style="transform:scaleX(-1)">
                <path d="M480 32c0-12.9-7.8-24.6-19.8-29.6s-25.7-2.2-34.9 6.9L381.7 53c-48 48-113.1 75-181 75l-8.7 0-32 0-96 0c-35.3 0-64 28.7-64 64l0 96c0 35.3 28.7 64 64 64l0 128c0 17.7 14.3 32 32 32l64 0c17.7 0 32-14.3 32-32l0-128 8.7 0c67.9 0 133 27 181 75l43.6 43.6c9.2 9.2 22.9 11.9 34.9 6.9s19.8-16.6 19.8-29.6l0-147.6c18.6-8.8 32-32.5 32-60.4s-13.4-51.6-32-60.4L480 32zm-64 76.7L416 240l0 131.3C357.2 317.8 280.5 288 200.7 288l-8.7 0 0-96 8.7 0c79.8 0 156.5-29.8 215.3-83.3z" />
            </svg>
        </h2>

        <div class="row">
            <div class="col-md-12">
                <div class="card category-card p-4 text-bg-primary">
                    @foreach (var notifications in ViewBag.announcements as List<Notifications>)
                    {
                        <h3>@notifications.Subject</h3>
                        <p>@notifications.Content</p>
                        <p>@notifications.dateTime.ToString("dd/MM/yyyy")</p>
                        <hr />
                    }

                </div>
            </div>
        </div>
        </div>


        <div class="container my-5">
            <h2 class="text-center mb-4">Haftanın Yazarları</h2>
            <div class="row justify-content-center align-items-end">

               
                <!-- 2.lik -->
                <div class="col-md-3 mb-3">
                    <div class="position-relative text-center" style="margin-top: 50px;">
                        <!-- Gümüş Madalya -->
                        <div class="position-absolute top-0 start-0">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="silver" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="black" stroke-width="1.5" fill="silver" />
                                <text x="8" y="16" font-size="8" font-weight="bold" fill="black">2</text>
                            </svg>
                        </div>
                        <img src="/Resimler/Yazarlar/@ViewBag.topauthor[1].AuthorImage" class="img-fluid rounded shadow" alt="Yazar 2">
                        <h5 class="mt-2">@ViewBag.topauthor[1].AuthorName</h5>
                    </div>
                </div>

                <!-- 1.lik -->
                <div class="col-md-3 mb-3">
                    <div class="position-relative text-center" style="margin-top: 0px;">
                        <!-- Altın Madalya -->
                        <div class="position-absolute top-0 start-0">
                            <svg width="48" height="64" viewBox="0 0 48 64" xmlns="http://www.w3.org/2000/svg">
                               
                                <circle cx="24" cy="12" r="10" stroke="black" stroke-width="1.5" fill="gold" />
                              
                                <text x="20" y="16" font-size="8" font-weight="bold" fill="black">1</text>



                                
                            </svg>

                        </div>
                        <img src="/Resimler/Yazarlar/@ViewBag.topauthor[0].AuthorImage" style="height:249px; Width:249px" class="img-fluid rounded shadow" alt="Yazar 1">
                        <h5 class="mt-2">@ViewBag.topauthor[0].AuthorName</h5>
                    </div>
                </div>

                <!-- 3.lük -->
                <div class="col-md-3 mb-3">
                    <div class="position-relative text-center" style="margin-top: 80px;">
                        <!-- Bronz Madalya -->
                        <div class="position-absolute top-0 start-0">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="#cd7f32" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" stroke="black" stroke-width="1.5" fill="#cd7f32" />
                                <text x="8" y="16" font-size="8" font-weight="bold" fill="black">3</text>
                            </svg>
                        </div>
                        <img src="/Resimler/Yazarlar/@ViewBag.topauthor[2].AuthorImage"
                        <h5 class="mt-2">@ViewBag.topauthor[2].AuthorName</h5>
                    </div>
                </div>
            </div>
        </div>


        
    <section>
    @{
        var rastgelekitap = ViewBag.rastgelekitap as List<Book>;
           
    }
    <!-- Recommended Books Section -->
    <div class="container my-1">
        <h2 class="text-center mb-4">Önerilen Kitaplar</h2>
        <div class="row">
            @foreach (var kitap in rastgelekitap)
            {


                <div class="col-md-3">
                    <div class="kitap-card">
                        <img src="@kitap.BookImage" class="card-img-top" alt="Kitap">
                        <div class="card-body">
                            <h6 class="card-title text-center mt-2 fw-bolder">@kitap.BookName</h6>
                            <p class="card-text text-center m-2 text-muted">@kitap.Author.AuthorName</p>

                            @*                             <span class="btn btn-danger  col-4" href="/Book/BookDetail/@kitap.AuthorId">Detay</span>
 *@                            
 <div class="container">
     <div class="row">
                                        <div class="col-6">
                                            <form method="post" asp-action="Borrow" asp-controller="Book" class="d-inline-block">
                                                @foreach (var item in Model)
                                                {
                                                    <input type="hidden" name="BookId" value="@item.BookId" />
                                                }

                                                <button type="submit" class="islev-button btn btn-primary btn-sm" style=" width:125px; height:45px;">Ödünç Al</button>
                                            </form> 
                                        </div>
                                        <div class="col-6">
                                            <form asp-action="AddToCart" asp-controller="Cart" method="post">
                                            @foreach (var item in Model)
                                            {
                                                <input type="hidden" name="BookId" value="@item.BookId" />
                                            }
                                                <button class="islev-button btn btn-primary btn-sm" style=" width:125px; height:45px;">
                                                    Sepete Ekle
                                                </button>
                                            </form>
                                        </div>

     </div>
 </div>
                        

                           <hr>
                                    <button  class="btn w-100 btn-danger mt-3">
                                    <a href="/Book/BookDetail/@kitap.BookId" style="color: white; text-decoration: none;">Detay</a>
                                </button>

                             
                    </div>
                     
                </div>
            </div>
            }
             
             
            
        </div>
    </div>
    </section>


    <section>
        <div class="container my-1">
            <h2 class="text-center mt-2">Yeni Eklenen Kitaplar</h2>
            <div class="row">
                @foreach (var kitap in  (List<Book>) @ViewBag.newbook)
                {


                    <div class="col-md-3">
                        <div class="kitap-card">
                            <img src="@kitap.BookImage" class="card-img-top" alt="Kitap">
                            <div class="card-body">
                                <h6 class="card-title text-center mt-2 fw-bolder">@kitap.BookName</h6>
                                <p class="card-text text-center m-2 text-muted">@kitap.Author.AuthorName</p>

                                @*                             <span class="btn btn-danger  col-4" href="/Book/BookDetail/@kitap.AuthorId">Detay</span>
 *@                            
     <div class="container">
                                    <div class="row">
                                        <div class="col-6">
                                            <form method="post" asp-action="Borrow" asp-controller="Book" class="d-inline-block">
                                                @foreach (var item in Model)
                                                {
                                                    <input type="hidden" name="BookId" value="@item.BookId" />
                                                }

                                                <button type="submit" class="islev-button btn btn-primary btn-sm" style=" width:125px; height:45px;">Ödünç Al</button>
                                            </form>
                                        </div>
                                        <div class="col-6">
                                            <form asp-action="AddToCart" asp-controller="Cart" method="post">
                                                @foreach (var item in Model)
                                                {
                                                    <input type="hidden" name="BookId" value="@item.BookId" />
                                                }
                                                <button class="islev-button btn btn-primary btn-sm" style=" width:125px; height:45px;">
                                                    Sepete Ekle
                                                </button>
                                            </form>
                                        </div>

                                    </div>
                                </div>
                                 

                               <hr>

                                <button class="btn w-100 btn-danger mt-3">
                                    <a href="/Book/BookDetail/@kitap.BookId" style="color: white; text-decoration: none;">Detay</a>
                                </button>



                            </div>

                        </div>
                    </div>
                }



            </div>
        </div>

    </section>

    
    <!-- Footer -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

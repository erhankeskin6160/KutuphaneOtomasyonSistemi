                        </p>

                        <div class="container">

                            <div class="row">

                                <div class="col-lg-6 col-md-12">
                                    <form action="@Url.Action("Borrow", "Book")" method="post" class="d-inline-block">
                                        <input type="hidden" name="bookId" value="@book.BookId" />

                                        <button type="submit" class="btn btn-primary card-button d-flex align-items-center justify-content-center btn-sm ">
                                            <i class="fa-solid fa-basket-shopping me-2 ps-4"></i>
                                            <span class="pe-4">Ödünç Al<span>
                                        </button>
                                    </form>
                                </div>
                                <!-- Sepete Ekle Butonu -->
                                <div class="col-lg-6 col-md-12">
                                    <form action="@Url.Action("AddToCart", "Cart")" method="post" class="d-inline">
                                        <input type="hidden" name="bookId" value="@book.BookId" />

                                        <button type="submit" class="btn btn-primary card-button d-flex align-items-center justify-content-center btn-sm float-end">
                                            <i class="fa-solid fa-basket-shopping me-2 ps-4"></i>
                                            <span class="pe-4"> Sepete Ekle</span>
                                        </button>
                                    </form>
                                </div>
                            




                            </div>


                        </div>
                        <!-- Detayları Gör Butonu -->
                        <hr />
                        <a href="/Book/BookDetail/@book.BookId" class="btn btn-danger card-button d-flex align-items-center justify-content-center p-1 rounded-5">
                            <i class="fa-solid fa-info-circle me-2"></i>
                            Detayları Gör
                        </a>
                    </div>  
                    
                    

            </div>
        </div>
    }
</div>
</div>



<div class="pagination">
    <!-- Önceki Sayfa Linki -->
    @if (Model.CurrentPage > 1)
    {
        <a href="@Url.Action("Book", "Home", new { page = Model.CurrentPage - 1, categoryId = Model.CategoryId, shortdate = Model.Shortdate })" class="btn btn-outline-primary">Önceki</a>
    }

    <!-- Sayfa Numaraları -->
    @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a href="@Url.Action("Book", "Home", new { page = i, categoryId = Model.CategoryId, shortdate = Model.Shortdate })"
           class="btn btn-outline-primary @(i == Model.CurrentPage ? "active" : "")">
            @i
        </a>
    }

    <!-- Sonraki Sayfa Linki -->
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a href="@Url.Action("Book", "Home", new { page = Model.CurrentPage + 1, categoryId = Model.CategoryId, shortdate = Model.Shortdate })" class="btn btn-outline-primary">Sonraki</a>
    }
</div>


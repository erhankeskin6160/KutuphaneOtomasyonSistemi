@model List<Book>
@{
    ViewData["Title"] = "SearchBook";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


 
<html>
<head>
    <link href="/css/Book/booklist.css" rel="stylesheet" />
    <style>
        .kitap-card {
            min-width: 13rem;
            min-height: 40rem;
        }
        
            .kitap-card img {
                width: 100%;
                height: 28rem;
                background-size: cover;
            }

        .card-button{
            font-size: 0.75rem;
        }
        </style>
</head>
